    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "お花さん、こんにちは！\nキミの歌ステキだね！"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
