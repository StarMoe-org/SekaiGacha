  TalkData:
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "ミクー、カイトー！\nどこにいるのー？"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "ん～、おっかしいなぁ。\nふたりは先にいるはずなんだけど……"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead03
      FacialName: face_sad_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_10_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "それにしても、ここはすごい所だな～。\n空飛ぶ汽車とか、ヘンな物がたくさんあるし"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-angry03
      FacialName: face_surprise_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "って、あれ？\n何かこっちに歩いてきてる……ぬいぐるみ？"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead02
      FacialName: face_smallmouth_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_27_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 69
    WindowDisplayName: ぬいぐるみ
    Body: ヤア！　新シイお客サンダネ！
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "わっ、キミ話せるんだね！\nねえねえ、カイトとミクがどこにいるか知ってる？"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-angry01
      FacialName: face_surprise_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_08_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 69
    WindowDisplayName: ぬいぐるみ
    Body: "座長とミクチャン？\n任セテ！　案内スルよ！"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 1
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 0
    WindowDisplayName: 歌う花
    Body: ～～～♪
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: ねえ、あの花は？
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 69
    WindowDisplayName: ぬいぐるみ
    Body: "彼女は歌がウマインダヨ！\n話シカケテミタラ？"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: うん！
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
