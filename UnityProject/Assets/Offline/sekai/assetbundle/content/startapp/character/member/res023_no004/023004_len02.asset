  TalkData:
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "よーし、カイト達みたいな楽しいショーを\nボクも試しにひとりで作ってみようっ！"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions: []
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_07_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "……と思って出て来てみたけど、\n何から手をつければいいんだ……？"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead01
      FacialName: face_sad_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "まずは内容を考えないといけないんだろうけど、\nどんなことをやったらおもしろいのかな？"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-plan01
      FacialName: face_sad_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "カイト達のショーみたいに、\n歌って踊って、物語があって、\nそれでお客さんが楽しめるもの……"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead03
      FacialName: face_sad_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_16_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: むむむ。難しいなあ……
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-glad01
      FacialName: face_sad_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "とりあえずショーをするのに必要なのは、\n台本？　いや、その前に役者？\nそうだ、衣装も必要だし、あとは……"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead02
      FacialName: face_smallmouth_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 0
    WindowDisplayName: ぬいぐるみ
    Body: "レンクン！　ガンバッテルネ。\n何か手伝エルコトがアッタラ、言ッテネ！"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "うん、ありがとう！\nじゃあさっそく聞きたいことがあるんだけど……"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-nod03
      FacialName: face_smile_03
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_05_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "今、ショーに必要なものを考えてるんだけど、\n台本とか衣装の他にも何かあるかな？"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead03
      FacialName: face_smallmouth_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 0
    WindowDisplayName: ぬいぐるみ
    Body: ウーン、大道具は考エタ？
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "そうだ、大道具！\n全然考えてなかった"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-smug01
      FacialName: face_surprise_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_02_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 0
    WindowDisplayName: ぬいぐるみ
    Body: "アトは、照明トカ、演出トカ。\n音楽も必要ダヨネ！"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "うっ……。\n思ったより準備大変そうだね……"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-lookdown01
      FacialName: face_sad_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "でもいろいろ見えてきたかも。\nもうちょっと、ひとりで考えてみるよ"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-nod02
      FacialName: face_smile_03
      TimingSyncValue: 0
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_07_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: 教えてくれてありがとう、ぬいぐるみさん！
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-nod04
      FacialName: face_smile_03
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 0
    WindowDisplayName: ぬいぐるみ
    Body: ウン！　応援シテルヨ！
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions: []
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 1
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "背景、照明、演出、音楽、\nそれに、台本、衣装、役決め……\nやることがこんなにたくさん……"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions: []
    Voices:
    - Character2dId: 28
      VoiceId: partvoice_10_023
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: ショーを作るって大変なんだな
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-tilthead03
      FacialName: face_smallmouth_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
    WindowDisplayName: レン
    Body: "見てるとあっという間だけど、\n準備してる時間ってあの何倍も何十倍も……\nいや、何百倍だって必要かも"
    TalkTention: 0
    LipSync: 0
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 28
      MotionName: n-len-lookdown01
      FacialName: face_smallmouth_01
      TimingSyncValue: 0
    Voices: []
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 28
