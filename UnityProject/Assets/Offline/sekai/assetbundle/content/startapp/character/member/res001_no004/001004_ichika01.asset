  TalkData:
  - TalkCharacters:
    - Character2dId: 1
    WindowDisplayName: 一歌
    Body: "あっ、もうこんな時間？\n私、そろそろバイトに行かなきゃ"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions: []
    Voices:
    - Character2dId: 1
      VoiceId: voice_card_01_04a_01_01
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 2
    WindowDisplayName: 咲希
    Body: "あっ、アタシも！\nついつい立ち話しちゃったね～"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions: []
    Voices:
    - Character2dId: 2
      VoiceId: voice_card_01_04a_02_02
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 3
    WindowDisplayName: 穂波
    Body: "そうだね。\nじゃあそろそろ解散しよっか"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions: []
    Voices:
    - Character2dId: 3
      VoiceId: voice_card_01_04a_03_03
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 4
    WindowDisplayName: 志歩
    Body: じゃ、私はこっちだから
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 4
      MotionName: w-cool-nod01
      FacialName: face_normal_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 4
      VoiceId: voice_card_01_04a_04_04
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 1
    WindowDisplayName: 一歌
    Body: みんな、また明日ね
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 1
      MotionName: w-cute-nod05
      FacialName: face_smile_02
      TimingSyncValue: 0
    Voices:
    - Character2dId: 1
      VoiceId: voice_card_01_04a_05_01
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 2
    WindowDisplayName: 咲希
    Body: ……ふふふっ
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 2
      MotionName: w-cute-tilthead07
      FacialName: face_smile_04
      TimingSyncValue: 0
    Voices:
    - Character2dId: 2
      VoiceId: voice_card_01_04a_06_02
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 3
    WindowDisplayName: 穂波
    Body: "どうしたの？　咲希ちゃん。\n急に笑い出したりして"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 3
      MotionName: w-adult-tilthead02
      FacialName: face_smallmouth_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 3
      VoiceId: voice_card_01_04a_07_03
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 2
    WindowDisplayName: 咲希
    Body: "ううんっ。\nただ、みんなとこうやって昔みたいに話せるのが嬉しくって！"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 2
      MotionName: w-cute-shakehead02
      FacialName: face_smile_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 2
      VoiceId: voice_card_01_04a_08_02
      Volume: 1
    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 1
    WindowDisplayName: 一歌
    Body: 昔みたいに……
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 1
      MotionName: w-happy-tilthead04
      FacialName: face_worry_01
      TimingSyncValue: 0
    Voices:
    - Character2dId: 1
