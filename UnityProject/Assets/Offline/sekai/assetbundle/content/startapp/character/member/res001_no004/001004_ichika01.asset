    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 2
    WindowDisplayName: 咲希
    Body: "明日はバイトもないし、\nみんなで集まってバンドの練習しようねっ！"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 2
      MotionName: w-normal-glad01
      FacialName: face_smile_01
