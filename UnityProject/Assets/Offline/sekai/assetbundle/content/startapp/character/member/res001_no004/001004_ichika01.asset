    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 4
    WindowDisplayName: 志歩
    Body: "どうせまたアップルパイでしょ？\n穂波もよく飽きないね"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 4
      MotionName: w-cool-trouble01
      FacialName: face_smile_05
