    Speed: 0
    FontSize: 0
    WhenFinishCloseWindow: 0
    RequirePlayEffect: 0
    EffectReferenceIdx: 0
    RequirePlaySound: 0
    SoundReferenceIdx: 0
    TargetValueScale: 0
  - TalkCharacters:
    - Character2dId: 3
    WindowDisplayName: 穂波
    Body: うん。おやつももってくるね
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 3
      MotionName: w-adult-nod03
      FacialName: face_smile_02
