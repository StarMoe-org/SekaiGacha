  - TalkCharacters:
    - Character2dId: 3
    WindowDisplayName: 穂波
    Body: "ううっ……。で、でも志歩ちゃんもおいしいって\n言ってくれてたよね？"
    TalkTention: 0
    LipSync: 1
    MotionChangeFrom: 1
    Motions:
    - Character2dId: 3
      MotionName: w-cute-fidget01
      FacialName: face_shy_01
